rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // Funcoes Auxiliares de Autenticacao e Multi-Tenant
    // ==========================================
    function isAutenticado() {
      return request.auth != null;
    }
    
    // NOVO: Descobre qual a empresa do usuario lendo a colecao global 'usuarios'
    function getEmpresaUsuario() {
      return isAutenticado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.empresaId
        : null;
    }

    // Busca o documento do funcionario dentro da subcolecao da empresa dele
    function getFuncionarioDoc(empresaId) {
      return isAutenticado() && exists(/databases/$(database)/documents/empresas/$(empresaId)/funcionarios/$(request.auth.uid))
        ? get(/databases/$(database)/documents/empresas/$(empresaId)/funcionarios/$(request.auth.uid)).data
        : {};
    }
    
    function isAdmin(empresaId) {
      return isAutenticado() && (
        request.auth.token.email == 'fabricadecoresgoiania@gmail.com' ||
        getFuncionarioDoc(empresaId).get('isAdmin', false) == true || 
        getFuncionarioDoc(empresaId).get('isAdmin', false) == 'true'
      );
    }
    
    function temPermissao(empresaId, perm) {
      return isAdmin(empresaId) || (
        isAutenticado() && (
          getFuncionarioDoc(empresaId).get(perm, false) == true ||
          getFuncionarioDoc(empresaId).get(perm, false) == 'true'
        )
      );
    }

    // ==========================================
    // Mapeamento Global de Usuarios (Login)
    // ==========================================
    match /usuarios/{userId} {
      allow read: if isAutenticado() && (request.auth.uid == userId || request.auth.token.email == 'fabricadecoresgoiania@gmail.com');
      // Permite o proprio usuario criar seu vinculo no onboarding
      allow create: if isAutenticado() && request.auth.uid == userId;
      // Apenas admin geral edita/deleta depois de criado
      allow update, delete: if isAutenticado() && request.auth.token.email == 'fabricadecoresgoiania@gmail.com';
    }

    // Função auxiliar para validar criação em lote (onboarding)
    function isDonoNoOnboarding(empresaId) {
      return isAutenticado() && existsAfter(/databases/$(database)/documents/empresas/$(empresaId)) &&
             getAfter(/databases/$(database)/documents/empresas/$(empresaId)).data.donoUid == request.auth.uid;
    }

    // ==========================================
    // Isolamento Multi-Tenant: Empresas
    // ==========================================
    match /empresas/{empresaId} {
      // Leitura do doc da empresa (para vitrine ou login)
      allow read: if true;
      // Permite criacao se o donoUid for o proprio usuario (onboarding)
      allow create: if isAutenticado() && request.resource.data.donoUid == request.auth.uid;
      allow update, delete: if isAutenticado() && request.auth.token.email == 'fabricadecoresgoiania@gmail.com';

      // ==========================================
      // 1. Configuracoes e Caixa Fisico
      // ==========================================
      match /configuracoes/{docId} {
        allow read: if true;
        allow write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_config') || temPermissao(empresaId, 'perm_gestao'));
        allow create: if isDonoNoOnboarding(empresaId); // Permite no batch de criacao
      }

      match /caixa/{docId} {
        allow read, write: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao'));
        allow create: if isDonoNoOnboarding(empresaId); // Permite no batch de criacao
      }

      // ==========================================
      // 2. Catalogo de Produtos e Movimentacoes
      // ==========================================
      match /produtos/{produtoId} {
        allow read: if true; // Publico para a loja virtual (vitrine)
        allow write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_cadastros') || temPermissao(empresaId, 'perm_pdv'));
      }

      match /movimentacoes/{movId} {
        allow read, create: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_cadastros') || temPermissao(empresaId, 'perm_gestao'));
        allow update, delete: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      match /categorias/{catId} {
        allow read: if true;
        allow write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_cadastros'));
      }

      // ==========================================
      // 3. Clientes e Fornecedores
      // ==========================================
      match /clientes/{clienteId} {
        allow read: if getEmpresaUsuario() == empresaId && isAutenticado();
        allow write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_cadastros') || temPermissao(empresaId, 'perm_pdv'));
      }

      match /fornecedores/{fornecedorId} {
        allow read, write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_cadastros') || temPermissao(empresaId, 'perm_gestao'));
      }

      // ==========================================
      // 4. Vendas, Orcamentos e Financeiro
      // ==========================================
      match /vendas/{vendaId} {
        allow read, create, update: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao'));
        allow delete: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      match /orcamentos/{orcamentoId} {
        allow read, write: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao'));
      }

      match /pedidos_site/{pedidoId} {
        allow create: if true; // Pedidos podem vir anonimamente da vitrine
        allow read, update, delete: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao'));
      }

      match /financeiro/{finId} {
        allow read, create: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_gestao') || temPermissao(empresaId, 'perm_pdv'));
        allow update, delete: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      match /compras/{compraId} {
        allow read, write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      match /notas_servico/{docId} {
        allow read: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao'));
        allow write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      match /notas_devolucao/{docId} {
        allow read: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao'));
        allow write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      match /notas_avulsas/{docId} {
        allow read: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao'));
        allow write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      // ==========================================
      // 5. Funcionarios / RH da Empresa
      // ==========================================
      match /funcionarios/{userId} {
        allow read: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || request.auth.uid == userId);
        // Regra para auto-cadastro simplificada para o tenant default durante a migracao, ou para o dono no onboarding
        allow create: if getEmpresaUsuario() == empresaId || isDonoNoOnboarding(empresaId) || (empresaId == 'emp_fc_moveis' && isAutenticado());
        allow update, delete: if getEmpresaUsuario() == empresaId && isAdmin(empresaId);
      }

      match /marketing_historico/{docId} {
        allow read, write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }
      
      match /relatorios_ia_historico/{docId} {
        allow read, write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      // Tudo mais bloqueado dentro do tenant
      match /{document=**} {
        allow read, write: if getEmpresaUsuario() == empresaId && isAdmin(empresaId);
      }
    }

    // Regras antigas mantidas TEMPORARIAMENTE apenas para o script de migracao poder rodar e nao quebrar na hora
    match /fc_moveis/{doc=**} { allow read, write: if true; }
    match /produtos/{doc=**} { allow read, write: if true; }
    match /vendas/{doc=**} { allow read, write: if true; }
    match /clientes/{doc=**} { allow read, write: if true; }
    match /fornecedores/{doc=**} { allow read, write: if true; }
    match /funcionarios/{doc=**} { allow read, write: if true; }
    match /orcamentos/{doc=**} { allow read, write: if true; }
    match /pedidos_site/{doc=**} { allow read, write: if true; }
    match /financeiro/{doc=**} { allow read, write: if true; }
    match /compras/{doc=**} { allow read, write: if true; }
    match /categorias/{doc=**} { allow read, write: if true; }
    match /movimentacoes/{doc=**} { allow read, write: if true; }
    match /notas_servico/{doc=**} { allow read, write: if true; }
    match /notas_devolucao/{doc=**} { allow read, write: if true; }
    match /notas_avulsas/{doc=**} { allow read, write: if true; }
    match /marketing_historico/{doc=**} { allow read, write: if true; }
    match /relatorios_ia_historico/{doc=**} { allow read, write: if true; }
  }
}
