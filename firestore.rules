rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // Funções Auxiliares de Autenticação e RBAC
    // ==========================================
    function isAutenticado() {
      return request.auth != null;
    }
    
    function getFuncionarioDoc() {
      return isAutenticado() && exists(/databases/$(database)/documents/funcionarios/$(request.auth.uid))
        ? get(/databases/$(database)/documents/funcionarios/$(request.auth.uid)).data
        : {};
    }
    
    function isAdmin() {
      return isAutenticado() && (
        request.auth.token.admin == true || 
        getFuncionarioDoc().get('isAdmin', false) == true || 
        getFuncionarioDoc().get('isAdmin', false) == 'true'
      );
    }
    
    function temPermissao(perm) {
      return isAdmin() || (
        isAutenticado() && (
          getFuncionarioDoc().get(perm, false) == true ||
          getFuncionarioDoc().get(perm, false) == 'true'
        )
      );
    }

    // ==========================================
    // 1. Configurações e Caixa Físico
    // ==========================================
    match /fc_moveis/config_loja {
      allow read: if true; // Dados públicos da vitrine (nome, logo, banners, cores)
      allow write: if isAdmin() || temPermissao('perm_config') || temPermissao('perm_gestao');
    }
    
    match /fc_moveis/config {
      allow read: if true; // Mantém compatibilidade de leitura do frontend existente
      allow write: if isAdmin() || temPermissao('perm_config') || temPermissao('perm_gestao');
    }

    match /fc_moveis/caixa {
      allow read: if isAutenticado() && (temPermissao('perm_pdv') || temPermissao('perm_gestao'));
      allow write: if isAutenticado() && (temPermissao('perm_pdv') || temPermissao('perm_gestao'));
    }

    match /fc_moveis/{document=**} {
      allow read: if isAutenticado();
      allow write: if isAdmin() || temPermissao('perm_config') || temPermissao('perm_gestao');
    }

    // ==========================================
    // 2. Catálogo de Produtos e Kardex
    // ==========================================
    match /produtos/{produtoId} {
      allow read: if true; // Leitura pública: necessária para a loja virtual
      allow write: if isAdmin() || temPermissao('perm_cadastros') || temPermissao('perm_pdv');
    }

    match /movimentacoes/{movId} {
      allow read: if isAutenticado() && (temPermissao('perm_pdv') || temPermissao('perm_cadastros') || temPermissao('perm_gestao'));
      allow create: if isAutenticado() && (temPermissao('perm_pdv') || temPermissao('perm_cadastros') || temPermissao('perm_gestao'));
      allow update, delete: if isAdmin() || temPermissao('perm_gestao');
    }

    match /categorias/{catId} {
      allow read: if true; // Categorias públicas para filtro da loja
      allow write: if isAdmin() || temPermissao('perm_cadastros');
    }

    // ==========================================
    // 3. Clientes e Fornecedores
    // ==========================================
    match /clientes/{clienteId} {
      allow read: if isAutenticado();
      allow write: if isAdmin() || temPermissao('perm_cadastros') || temPermissao('perm_pdv');
    }

    match /fornecedores/{fornecedorId} {
      allow read, write: if isAdmin() || temPermissao('perm_cadastros') || temPermissao('perm_gestao');
    }

    // ==========================================
    // 4. Vendas, Orçamentos, Pedidos do Site e Financeiro
    // ==========================================
    match /vendas/{vendaId} {
      allow read: if isAutenticado() && (temPermissao('perm_pdv') || temPermissao('perm_gestao'));
      allow create: if isAutenticado() && (temPermissao('perm_pdv') || temPermissao('perm_gestao'));
      allow update: if isAutenticado() && (temPermissao('perm_pdv') || temPermissao('perm_gestao'));
      allow delete: if isAdmin() || temPermissao('perm_gestao');
    }

    match /orcamentos/{orcamentoId} {
      allow read, write: if isAutenticado() && (temPermissao('perm_pdv') || temPermissao('perm_gestao'));
    }

    match /pedidos_site/{pedidoId} {
      allow create: if true; // Clientes da loja online registram pedidos
      allow read, update, delete: if isAutenticado() && (temPermissao('perm_pdv') || temPermissao('perm_gestao'));
    }

    match /financeiro/{finId} {
      // PDV precisa criar títulos a receber para vendas no crediário/cartão/pix
      allow read: if isAutenticado() && (temPermissao('perm_gestao') || temPermissao('perm_pdv'));
      allow create: if isAutenticado() && (temPermissao('perm_gestao') || temPermissao('perm_pdv'));
      allow update, delete: if isAdmin() || temPermissao('perm_gestao');
    }

    match /compras/{compraId} {
      allow read, write: if isAdmin() || temPermissao('perm_gestao');
    }

    // ==========================================
    // 5. Funcionários e Controle de Acesso
    // ==========================================
    match /funcionarios/{userId} {
      allow read: if isAutenticado();
      allow create: if isAutenticado() && (
        isAdmin() || (
          request.auth.uid == userId 
          && (request.resource.data.isAdmin == false || request.resource.data.isAdmin == 'false')
          && (request.resource.data.perm_dashboard == false || request.resource.data.perm_dashboard == 'false')
          && (request.resource.data.perm_pdv == false || request.resource.data.perm_pdv == 'false')
          && (request.resource.data.perm_cadastros == false || request.resource.data.perm_cadastros == 'false')
          && (request.resource.data.perm_gestao == false || request.resource.data.perm_gestao == 'false')
          && (request.resource.data.perm_config == false || request.resource.data.perm_config == 'false')
        )
      );
      allow update, delete: if isAdmin();
    }

    // ==========================================
    // 6. Marketing e Histórico IA
    // ==========================================
    match /marketing_historico/{docId} {
      allow read, write: if isAutenticado();
    }

    // Fallback de Segurança
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
