rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // Funcoes Auxiliares de Autenticacao e Multi-Tenant
    // ==========================================
    function isAutenticado() {
      return request.auth != null;
    }
    
    // NOVO: Descobre qual a empresa do usuario lendo a colecao global 'usuarios'
    function getEmpresaUsuario() {
      return isAutenticado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        ? get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.empresaId
        : null;
    }

    // Busca o documento do funcionario dentro da subcolecao da empresa dele
    function getFuncionarioDoc(empresaId) {
      return isAutenticado() && exists(/databases/$(database)/documents/empresas/$(empresaId)/funcionarios/$(request.auth.uid))
        ? get(/databases/$(database)/documents/empresas/$(empresaId)/funcionarios/$(request.auth.uid)).data
        : {};
    }
    
    function isSuperAdmin() {
      return isAutenticado() && (
        request.auth.token.email == 'pauloaugusto.silvaborges@gmail.com' ||
        request.auth.token.email == 'fabricadecoresgoiania@gmail.com'
      );
    }

    function isAdmin(empresaId) {
      return isAutenticado() && (
        isSuperAdmin() ||
        getFuncionarioDoc(empresaId).get('isAdmin', false) == true || 
        getFuncionarioDoc(empresaId).get('isAdmin', false) == 'true'
      );
    }
    
    function temPermissao(empresaId, perm) {
      return isAdmin(empresaId) || (
        isAutenticado() && (
          getFuncionarioDoc(empresaId).get(perm, false) == true ||
          getFuncionarioDoc(empresaId).get(perm, false) == 'true'
        )
      );
    }
    
    function podeCadastrarProdutos(empresaId) {
      return isAdmin(empresaId) || (
        isAutenticado() && (
          getFuncionarioDoc(empresaId).get('perm_produtos', getFuncionarioDoc(empresaId).get('perm_cadastros', false)) == true ||
          getFuncionarioDoc(empresaId).get('perm_produtos', getFuncionarioDoc(empresaId).get('perm_cadastros', false)) == 'true'
        )
      );
    }

    function podeCadastrarClientes(empresaId) {
      return isAdmin(empresaId) || (
        isAutenticado() && (
          getFuncionarioDoc(empresaId).get('perm_clientes', getFuncionarioDoc(empresaId).get('perm_cadastros', false)) == true ||
          getFuncionarioDoc(empresaId).get('perm_clientes', getFuncionarioDoc(empresaId).get('perm_cadastros', false)) == 'true'
        )
      );
    }

    // ==========================================
    // Mapeamento Global de Usuarios (Login)
    // ==========================================
    match /usuarios/{userId} {
      allow read: if isAutenticado() && (
        request.auth.uid == userId || 
        isSuperAdmin() ||
        getEmpresaUsuario() == resource.data.empresaId
      );
      // Permite o proprio usuario no onboarding OU o admin da empresa cadastrando funcionario
      allow create: if isAutenticado() && (
        request.auth.uid == userId ||
        isSuperAdmin() ||
        (getEmpresaUsuario() != null && getEmpresaUsuario() == request.resource.data.empresaId && isAdmin(getEmpresaUsuario()))
      );
      // Apenas admin geral ou admin da empresa pode atualizar/deletar seus funcionarios (sem alterar empresaId)
      allow update: if isAutenticado() && (
        isSuperAdmin() ||
        (getEmpresaUsuario() != null && getEmpresaUsuario() == resource.data.empresaId && isAdmin(getEmpresaUsuario()) && request.resource.data.empresaId == resource.data.empresaId)
      );
      allow delete: if isAutenticado() && (
        isSuperAdmin() ||
        (getEmpresaUsuario() != null && getEmpresaUsuario() == resource.data.empresaId && isAdmin(getEmpresaUsuario()))
      );
    }

    // Função auxiliar para validar criação em lote (onboarding)
    function isDonoNoOnboarding(empresaId) {
      return isAutenticado() && existsAfter(/databases/$(database)/documents/empresas/$(empresaId)) &&
             getAfter(/databases/$(database)/documents/empresas/$(empresaId)).data.donoUid == request.auth.uid;
    }

    // ==========================================
    // Isolamento Multi-Tenant: Empresas
    // ==========================================
    match /empresas/{empresaId} {
      // Leitura do doc da empresa (para vitrine ou login)
      allow read: if true;
      // Permite criacao se o donoUid for o proprio usuario (onboarding) ou Super Admin
      allow create: if isAutenticado() && (request.resource.data.donoUid == request.auth.uid || isSuperAdmin());
      allow update, delete: if isSuperAdmin();

      // ==========================================
      // 1. Configuracoes e Caixa Fisico
      // ==========================================
      match /configuracoes/{docId} {
        allow read: if isAutenticado() && (getEmpresaUsuario() == empresaId || isSuperAdmin());
        allow write: if (getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_config') || temPermissao(empresaId, 'perm_gestao'))) || isSuperAdmin();
        allow create: if isDonoNoOnboarding(empresaId) || isSuperAdmin(); // Permite no batch de criacao
      }

      // Segredos Fiscais (Certificado A1 .pfx e senha privada) - Restrito a Administradores
      match /segredos_fiscais/{docId} {
        allow read, write: if (getEmpresaUsuario() == empresaId && isAdmin(empresaId)) || isSuperAdmin();
      }

      match /caixa/{docId} {
        allow read, write: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao'));
        allow create: if isDonoNoOnboarding(empresaId); // Permite no batch de criacao
      }

      // ==========================================
      // 2. Catalogo de Produtos e Movimentacoes
      // ==========================================
      match /produtos/{produtoId} {
        allow read: if true; // Publico para a loja virtual (vitrine)
        allow create, delete: if getEmpresaUsuario() == empresaId && podeCadastrarProdutos(empresaId);
        allow update: if getEmpresaUsuario() == empresaId && (
          podeCadastrarProdutos(empresaId) ||
          (temPermissao(empresaId, 'perm_pdv') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estoque', 'ultimaAtualizacao']))
        );
      }

      match /movimentacoes/{movId} {
        allow read, create: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_cadastros') || temPermissao(empresaId, 'perm_gestao'));
        allow update, delete: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      match /categorias/{catId} {
        allow read: if true;
        allow write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || podeCadastrarProdutos(empresaId) || temPermissao(empresaId, 'perm_cadastros'));
      }

      // ==========================================
      // 3. Clientes e Fornecedores
      // ==========================================
      match /clientes/{clienteId} {
        allow read: if getEmpresaUsuario() == empresaId && isAutenticado();
        allow write: if getEmpresaUsuario() == empresaId && podeCadastrarClientes(empresaId);
      }

      match /fornecedores/{fornecedorId} {
        allow read, write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_cadastros') || temPermissao(empresaId, 'perm_gestao'));
      }

      // ==========================================
      // 4. Vendas, Orcamentos e Financeiro
      // ==========================================
      match /vendas/{vendaId} {
        allow read, create, update: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao'));
        allow delete: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      match /orcamentos/{orcamentoId} {
        allow read, write: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao'));
      }

      match /pedidos_site/{pedidoId} {
        allow read: if (getEmpresaUsuario() == empresaId && isAutenticado()) || isSuperAdmin();
        allow create: if true; // Pedidos podem vir anonimamente da vitrine
        allow update, delete: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao'));
      }

      match /financeiro/{finId} {
        allow read: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
        allow create: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao') || temPermissao(empresaId, 'perm_pdv'));
        allow update, delete: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      match /compras/{compraId} {
        allow read, write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      match /notas_servico/{docId} {
        allow read: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao'));
        allow write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      match /notas_devolucao/{docId} {
        allow read: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao'));
        allow write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      match /notas_avulsas/{docId} {
        allow read: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao'));
        allow write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      match /notas_fiscais/{docId} {
        allow read: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao'));
        allow write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      match /caixa/{caixaId} {
        allow read, write: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao') || isAdmin(empresaId));
      }

      match /caixa_fechamentos/{docId} {
        allow read, create: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao'));
        allow update, delete: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      match /fechamentos_caixa/{docId} {
        allow read, create: if getEmpresaUsuario() == empresaId && (temPermissao(empresaId, 'perm_pdv') || temPermissao(empresaId, 'perm_gestao'));
        allow update, delete: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      // ==========================================
      // 5. Funcionarios / RH da Empresa
      // ==========================================
      match /funcionarios/{userId} {
        allow read: if (getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || request.auth.uid == userId)) || isSuperAdmin();
        // Permite criacao pelo admin da empresa, pelo dono no onboarding ou pelo super admin
        allow create: if (getEmpresaUsuario() == empresaId && isAdmin(empresaId)) || isDonoNoOnboarding(empresaId) || isSuperAdmin();
        allow update, delete: if (getEmpresaUsuario() == empresaId && isAdmin(empresaId)) || isSuperAdmin();
      }

      match /marketing_historico/{docId} {
        allow read, write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }
      
      match /relatorios_ia_historico/{docId} {
        allow read, write: if getEmpresaUsuario() == empresaId && (isAdmin(empresaId) || temPermissao(empresaId, 'perm_gestao'));
      }

      // Tudo mais bloqueado dentro do tenant
      match /{document=**} {
        allow read, write: if getEmpresaUsuario() == empresaId && isAdmin(empresaId);
      }
    }

    // ==========================================
    // Gestão de Planos e Contratos do SaaS Master
    // ==========================================
    match /planos_saas/{planoId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    match /contratos_saas/{contratoId} {
      allow read, write: if isSuperAdmin();
    }

    match /saas_config/{docId} {
      allow read: if isAutenticado();
      allow write: if isSuperAdmin();
    }

    // Regras legadas de raiz bloqueadas contra acesso publico (apenas Super Admin para manutencao)
    match /fc_moveis/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /produtos/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /vendas/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /clientes/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /fornecedores/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /funcionarios/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /orcamentos/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /pedidos_site/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /financeiro/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /compras/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /categorias/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /movimentacoes/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /notas_servico/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /notas_devolucao/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /notas_avulsas/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /marketing_historico/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /relatorios_ia_historico/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /caixa/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /caixa_fechamentos/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /fechamentos_caixa/{doc=**} { allow read, write: if isSuperAdmin(); }
    match /notas_fiscais/{doc=**} { allow read, write: if isSuperAdmin(); }
  }
}
