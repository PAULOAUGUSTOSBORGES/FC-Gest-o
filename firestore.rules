rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função para pegar os dados do usuário atual de forma segura
    function getFuncionario() {
      return request.auth != null && exists(/databases/$(database)/documents/funcionarios/$(request.auth.uid))
        ? get(/databases/$(database)/documents/funcionarios/$(request.auth.uid)).data
        : {};
    }
    
    // Função para checar se é Admin Master
    function isAdmin() {
      return request.auth != null && (
        getFuncionario().get('isAdmin', false) == true || 
        getFuncionario().get('isAdmin', false) == 'true'
      );
    }

    // ==========================================
    // 1. Financeiro, Caixa e Configurações
    // ==========================================
    match /financeiro/{document=**} {
      allow read, write: if isAdmin() || (request.auth != null && (
        getFuncionario().get('perm_gestao', false) == true || 
        getFuncionario().get('perm_gestao', false) == 'true'
      ));
    }
    
    // Leitura das configurações globais permitida a qualquer autenticado
    match /fc_moveis/config {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && (
        getFuncionario().get('perm_gestao', false) == true || 
        getFuncionario().get('perm_gestao', false) == 'true' ||
        getFuncionario().get('perm_config', false) == true || 
        getFuncionario().get('perm_config', false) == 'true' ||
        getFuncionario().get('perm_pdv', false) == true || 
        getFuncionario().get('perm_pdv', false) == 'true'
      ));
    }

    match /fc_moveis/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && (
        getFuncionario().get('perm_gestao', false) == true || 
        getFuncionario().get('perm_gestao', false) == 'true' ||
        getFuncionario().get('perm_config', false) == true || 
        getFuncionario().get('perm_config', false) == 'true'
      ));
    }

    match /compras/{document=**} {
      allow read, write: if isAdmin() || (request.auth != null && (
        getFuncionario().get('perm_gestao', false) == true || 
        getFuncionario().get('perm_gestao', false) == 'true'
      ));
    }
    
    // ==========================================
    // 2. Vendas e Orçamentos (PDV ou Admin)
    // ==========================================
    match /vendas/{document=**} {
      allow read, write: if isAdmin() || (request.auth != null && (
        getFuncionario().get('perm_pdv', false) == true || 
        getFuncionario().get('perm_pdv', false) == 'true' ||
        getFuncionario().get('perm_gestao', false) == true || 
        getFuncionario().get('perm_gestao', false) == 'true'
      ));
    }
    match /orcamentos/{document=**} {
      allow read, write: if isAdmin() || (request.auth != null && (
        getFuncionario().get('perm_pdv', false) == true || 
        getFuncionario().get('perm_pdv', false) == 'true' ||
        getFuncionario().get('perm_gestao', false) == true || 
        getFuncionario().get('perm_gestao', false) == 'true'
      ));
    }
    
    // ==========================================
    // 3. Cadastros Básicos
    // ==========================================
    match /produtos/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && (
        getFuncionario().get('perm_cadastros', false) == true || 
        getFuncionario().get('perm_cadastros', false) == 'true' ||
        getFuncionario().get('perm_pdv', false) == true || 
        getFuncionario().get('perm_pdv', false) == 'true'
      ));
    }
    match /clientes/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && (
        getFuncionario().get('perm_cadastros', false) == true || 
        getFuncionario().get('perm_cadastros', false) == 'true' ||
        getFuncionario().get('perm_pdv', false) == true || 
        getFuncionario().get('perm_pdv', false) == 'true'
      ));
    }
    match /fornecedores/{document=**} {
      allow read, write: if isAdmin() || (request.auth != null && (
        getFuncionario().get('perm_cadastros', false) == true || 
        getFuncionario().get('perm_cadastros', false) == 'true' ||
        getFuncionario().get('perm_gestao', false) == true || 
        getFuncionario().get('perm_gestao', false) == 'true'
      ));
    }
    match /categorias/{document=**} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && (
        getFuncionario().get('perm_cadastros', false) == true || 
        getFuncionario().get('perm_cadastros', false) == 'true'
      ));
    }
    
    // ==========================================
    // 4. Movimentações de Estoque
    // ==========================================
    match /movimentacoes/{document=**} {
      allow read, write: if isAdmin() || (request.auth != null && (
        getFuncionario().get('perm_pdv', false) == true || 
        getFuncionario().get('perm_pdv', false) == 'true' || 
        getFuncionario().get('perm_cadastros', false) == true || 
        getFuncionario().get('perm_cadastros', false) == 'true' ||
        getFuncionario().get('perm_gestao', false) == true || 
        getFuncionario().get('perm_gestao', false) == 'true'
      ));
    }
    
    // ==========================================
    // 5. Funcionários
    // ==========================================
    match /funcionarios/{userId} {
      allow read: if request.auth != null;
      allow create: if isAdmin() || (
        request.auth.uid == userId 
        && (request.resource.data.isAdmin == false || request.resource.data.isAdmin == 'false')
        && (request.resource.data.perm_dashboard == false || request.resource.data.perm_dashboard == 'false')
        && (request.resource.data.perm_pdv == false || request.resource.data.perm_pdv == 'false')
        && (request.resource.data.perm_cadastros == false || request.resource.data.perm_cadastros == 'false')
        && (request.resource.data.perm_gestao == false || request.resource.data.perm_gestao == 'false')
        && (request.resource.data.perm_config == false || request.resource.data.perm_config == 'false')
      );
      allow update, delete: if isAdmin();
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
